rules_version = '2';
// Pega estas reglas en: Consola de Firebase → Firestore Database → Reglas → Publicar
//
// Estas reglas son la verdadera defensa: aunque alguien se salte la página y
// escriba directo en la base de datos (con la consola del navegador, scripts o la API),
// aquí se rechaza todo lo que no tenga el formato, tamaño y permisos correctos.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién es ----------
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // Para aceptar solo correos de tu universidad, cambia `true` por:
    //   request.auth.token.email.matches('.*@miuni[.]edu$')
    function allowedUser() { return signedIn() && true; }
    // Cuenta real (Google o correo). Los invitados usan sesión anónima: pueden pedir, pero no vender.
    function realUser() { return allowedUser() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // Para vender: con correo y contraseña, el correo debe estar verificado (Google ya viene verificado).
    function canSell() {
      return realUser() && notBanned() && (request.auth.token.firebase.sign_in_provider != 'password' || request.auth.token.email_verified == true);
    }

    // ---------- Administradores y moderación ----------
    // Un administrador es quien tiene un documento en /admins/{su uid}. Esa colección NO se puede
    // escribir desde la página: los administradores se agregan a mano en la consola de Firebase.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Baneado o suspendido (mientras dure la suspensión) = no puede publicar, pedir, calificar ni reportar.
    function notBanned() {
      let path = /databases/$(database)/documents/moderation/$(request.auth.uid);
      return !exists(path)
        || get(path).data.status in ['ok', 'warned']
        || (get(path).data.status == 'suspended' && get(path).data.until < request.time);
    }

    // ---------- Ayudas de validación ----------
    function d() { return request.resource.data; }
    function txt(v, max) { return v is string && v.size() <= max; }
    function optTxt(m, k, max) { return !m.keys().hasAny([k]) || txt(m[k], max); }

    // ---------- Perfiles (PRIVADOS: nadie puede descargar los teléfonos de otros) ----------
    function validProfile(p) {
      return p.keys().hasOnly(['name', 'phone', 'faculty', 'studentCode', 'payments', 'notifyOrders', 'nameConfirmed'])
        && (!p.keys().hasAny(['nameConfirmed']) || p.nameConfirmed is bool)
        && (!p.keys().hasAny(['notifyOrders']) || p.notifyOrders is bool)
        && optTxt(p, 'name', 60) && optTxt(p, 'phone', 20) && optTxt(p, 'faculty', 60) && optTxt(p, 'studentCode', 20)
        && (!p.keys().hasAny(['payments']) || (p.payments is list && p.payments.size() <= 2));
    }
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid) && realUser() && validProfile(d());
      allow delete: if false;

      // Datos para cobrar (CLABE / tarjeta): solo el dueño
      match /private/{doc} {
        allow read: if isMe(uid);
        allow write: if isMe(uid) && realUser()
          && d().keys().hasOnly(['transfer', 'transferInfo'])
          && (!d().keys().hasAny(['transfer']) || (d().transfer is map && d().transfer.keys().hasOnly(['method', 'holder', 'bank', 'clabe', 'card', 'note'])))
          && optTxt(d(), 'transferInfo', 400);
      }
    }

    // ---------- Publicaciones ----------
    function validProduct(p) {
      return p.keys().hasOnly(['title', 'price', 'stock', 'category', 'sub', 'mode', 'description', 'spot', 'schedule', 'phone',
                               'payments', 'active', 'thumb', 'images', 'sold', 'options', 'sellerId', 'sellerName', 'sellerPhoto', 'createdAt', 'updatedAt'])
        && txt(p.title, 80) && p.title.size() >= 3
        && p.price is number && p.price >= 0 && p.price <= 1000000
        && (p.get('stock', null) == null || (p.stock is int && p.stock >= 0 && p.stock <= 100000))
        && txt(p.category, 30)
        && optTxt(p, 'sub', 60) && optTxt(p, 'description', 1000) && optTxt(p, 'spot', 60) && optTxt(p, 'schedule', 60) && optTxt(p, 'phone', 20)
        && p.get('mode', 'inmediato') in ['inmediato', 'preorden']
        && (!p.keys().hasAny(['payments']) || (p.payments is list && p.payments.size() >= 1 && p.payments.size() <= 2))
        && p.get('active', true) is bool
        && optTxt(p, 'thumb', 60000)
        && (!p.keys().hasAny(['images']) || (p.images is list && p.images.size() <= 4))
        && (!p.keys().hasAny(['sold']) || (p.sold is int && p.sold >= 0 && p.sold <= 10000000))
        // Opciones para elegir (ej. "Frutas: elige 2"): máximo 4 grupos.
        && (!p.keys().hasAny(['options']) || (p.options is list && p.options.size() <= 4))
        && txt(p.sellerName, 60) && optTxt(p, 'sellerPhoto', 500);
    }
    match /products/{id} {
      allow read: if true;
      allow create: if canSell() && d().sellerId == request.auth.uid && validProduct(d())
        && d().createdAt == request.time && d().updatedAt == request.time;
      allow update: if isMe(resource.data.sellerId) && notBanned() && d().sellerId == resource.data.sellerId
        && d().createdAt == resource.data.createdAt && d().updatedAt == request.time
        && validProduct(d());
      // Un administrador solo puede ocultar o volver a mostrar una publicación (no editarla).
      allow update: if isAdmin() && d().diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
        && d().active is bool && d().updatedAt == request.time;
      // El vendedor borra sus publicaciones; un administrador puede quitar cualquiera (moderación).
      allow delete: if isMe(resource.data.sellerId) || isAdmin();
    }

    // Fotos de versiones anteriores (antes de ImgBB)
    match /productImages/{id} {
      allow read: if true;
      allow create: if canSell() && d().sellerId == request.auth.uid
        && d().keys().hasOnly(['images', 'sellerId']) && d().images is list && d().images.size() <= 4;
      allow update: if isMe(resource.data.sellerId) && d().sellerId == resource.data.sellerId
        && d().keys().hasOnly(['images', 'sellerId']) && d().images is list && d().images.size() <= 4;
      allow delete: if isMe(resource.data.sellerId);
    }

    // ---------- Pedidos ----------
    function productOf(pid) { return get(/databases/$(database)/documents/products/$(pid)).data; }
    // Un pedido nuevo debe copiar fielmente el producto real: no se puede inventar precio, total, vendedor ni título.
    function validNewOrder(o) {
      let p = productOf(o.productId);
      return o.keys().hasOnly(['productId', 'productTitle', 'productThumb', 'category', 'price', 'qty', 'total',
                               'sellerId', 'sellerName', 'sellerPhone', 'buyerId', 'buyerName', 'buyerEmail', 'buyerPhone',
                               'buyerCode', 'guest', 'spot', 'payment', 'note', 'options', 'status', 'mode', 'pickupAt', 'createdAt', 'updatedAt'])
        && o.buyerId == request.auth.uid
        && o.status == 'pendiente'
        && o.createdAt == request.time && o.updatedAt == request.time
        && p.get('active', true) == true
        && o.sellerId == p.sellerId && o.sellerId != request.auth.uid
        && o.productTitle == p.title && o.category == p.category
        && o.sellerName == p.sellerName && o.sellerPhone == p.get('phone', '')
        && o.productThumb == p.get('thumb', '')
        && o.price == p.price
        && o.qty is int && o.qty >= 1 && o.qty <= 50
        && (p.get('stock', null) == null || o.qty <= p.stock)
        && o.total == o.price * o.qty
        && o.payment in p.get('payments', ['Efectivo', 'Transferencia'])
        && o.mode == p.get('mode', 'inmediato')
        && (o.pickupAt == null || o.pickupAt is int)
        && o.guest is bool
        && txt(o.buyerName, 60) && txt(o.buyerPhone, 20) && txt(o.buyerCode, 20)
        && (o.buyerEmail == '' || o.buyerEmail == request.auth.token.get('email', ''))
        && txt(o.spot, 60) && txt(o.note, 300) && optTxt(o, 'options', 300);
    }
    function validTransition(from, to) {
      return (from == 'pendiente' && to in ['aceptado', 'rechazado'])
        || (from == 'aceptado' && to in ['entregado', 'cancelado']);
    }

    // Solo los ven el comprador (con cuenta o invitado) y el vendedor
    match /orders/{id} {
      // Comprador, vendedor o un administrador (para revisar reportes de estafa).
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if allowedUser() && notBanned() && validNewOrder(d());
      allow update: if signedIn() && (
          // El vendedor: solo cambia el estado (en orden lógico) y adjunta sus datos para cobrar
          (resource.data.sellerId == request.auth.uid
            && d().diff(resource.data).affectedKeys().hasOnly(['status', 'transfer', 'transferInfo', 'updatedAt'])
            && validTransition(resource.data.status, d().status)
            && d().updatedAt == request.time
            && optTxt(d(), 'transferInfo', 400))
          // El comprador: solo puede cancelar mientras esté pendiente
          || (resource.data.buyerId == request.auth.uid
            && resource.data.status == 'pendiente' && d().status == 'cancelado'
            && d().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && d().updatedAt == request.time)
        );
      allow delete: if false;
    }

    // ---------- Reseñas ----------
    // Una por pedido (el id de la reseña es el id del pedido), solo del comprador y solo si ya se entregó.
    function orderOf(oid) { return get(/databases/$(database)/documents/orders/$(oid)).data; }
    match /reviews/{orderId} {
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && d().keys().hasOnly(['productId', 'sellerId', 'buyerId', 'buyerName', 'rating', 'comment', 'productTitle', 'createdAt'])
        && d().buyerId == request.auth.uid
        && d().rating is int && d().rating >= 1 && d().rating <= 5
        && txt(d().comment, 300) && txt(d().buyerName, 40) && txt(d().productTitle, 80)
        && d().createdAt == request.time
        && orderOf(orderId).buyerId == request.auth.uid
        && orderOf(orderId).status == 'entregado'
        && orderOf(orderId).productId == d().productId
        && orderOf(orderId).sellerId == d().sellerId;
      allow update: if false;
      allow delete: if isAdmin();   // moderación de reseñas ofensivas
    }

    // ---------- Administración ----------
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;        // solo desde la consola de Firebase
    }
    // Avisos, suspensiones y baneos: los pone un administrador; el usuario solo puede ver el suyo.
    match /moderation/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Historial de acciones de los administradores: se puede agregar, nunca editar ni borrar.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && d().keys().hasOnly(['adminUid', 'adminEmail', 'action', 'targetType', 'targetId', 'targetName', 'details', 'at'])
        && d().adminUid == request.auth.uid && d().at == request.time
        && txt(d().action, 40) && txt(d().targetType, 20) && txt(d().targetId, 128) && txt(d().targetName, 80) && txt(d().details, 1000);
      allow update, delete: if false;
    }

    // ---------- Reportes ----------
    // Uno por persona y por cosa reportada (el id lo deja claro); solo los administradores los leen.
    match /reports/{id} {
      allow create: if signedIn() && notBanned()
        && id == request.auth.uid + '_' + d().targetType + '_' + d().targetId
        && d().keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetName', 'sellerId', 'reason', 'details', 'status', 'createdAt'])
        && d().reporterId == request.auth.uid
        && d().targetType in ['product', 'user']
        && txt(d().targetId, 128) && txt(d().targetName, 80) && txt(d().sellerId, 128)
        && d().reason in ['prohibido', 'estafa', 'ofensivo', 'falso', 'spam', 'otro']
        && txt(d().details, 500)
        && d().status == 'nuevo' && d().createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Soporte y sugerencias ----------
    match /support/{id} {
      allow create: if d().keys().hasOnly(['kind', 'name', 'email', 'message', 'uid', 'page', 'status', 'createdAt'])
        && d().kind in ['problema', 'sugerencia', 'otro']
        && txt(d().name, 60) && txt(d().email, 120) && txt(d().page, 200)
        && txt(d().message, 2000) && d().message.size() >= 5
        && (d().uid == '' || (signedIn() && d().uid == request.auth.uid))
        && d().status == 'nuevo' && d().createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
